{
  "version": 1,
  "allowedHosts": ["example.com"],
  "viewport": { "width": 1280, "height": 720 },
  "deviceScaleFactor": 1,
  "locale": "en-US",
  "fps": 30,
  "mask": { "selectors": [], "textPatterns": [], "builtin": true },
  "forbidControls": [],
  "steps": [
    { "action": "goto", "url": "https://example.com" },
    { "action": "wait", "ms": 1500 },
    { "action": "mark", "name": "overview" },
    { "action": "scroll", "y": 300, "durationMs": 1000 },
    { "action": "wait", "ms": 1500 },
    { "action": "mark", "name": "end" }
  ]
}
